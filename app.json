{
  "expo": {
    "name": "sorak-rnr",
    "slug": "sorak-rnr",
    "owner": "hancontam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sorak-app-icon.png",
    "scheme": "sorak-rnr",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sorak.rnr"
    },
    "android": {
      "package": "com.sorak.rnr",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/sorak-adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/sorak-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sorak-splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sorak dùng ảnh bạn chọn để nhận diện người được ủy quyền đón trẻ.",
          "cameraPermission": "Sorak dùng camera để chụp ảnh người được ủy quyền đón trẻ.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "35b5c14a-dcd4-400f-8662-e3c5d55b112f"
      }
    }
  }
}
